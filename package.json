{
  "name": "timelock-message-vault",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev -- --host 0.0.0.0 --port ${PORT:-4000}",
    "start": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && npm --prefix frontend run build",
    "test": "node --experimental-strip-types --test server/firstSlice.test.ts server/addons.test.ts",
    "test:browser": "node --experimental-strip-types server/browser-check.mjs"
  },
  "type": "module",
  "dependencies": { "express": "5.2.1", "pg": "8.23.1" },
  "devDependencies": { "@types/express": "5.0.3", "@types/pg": "8.15.5", "typescript": "5.7.3", "@types/node": "22.19.15", "playwright": "1.63.0" }
}
